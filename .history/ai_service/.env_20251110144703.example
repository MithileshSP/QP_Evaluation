GEMINI_API_KEY=your_gemini_api_key_here
# Recommended: gemini-2.0-flash-exp (faster) or gemini-1.5-pro (better quality)
GEMINI_MODEL=gemini-2.0-flash-exp
# API version: v1alpha for latest models, v1 for stable
GEMINI_API_VERSION=v1alpha
PORT=8100

# Performance tuning
GEMINI_TIMEOUT_MS=120000
MAX_CONCURRENT_EVALUATIONS=1
MIN_EVALUATION_INTERVAL_MS=1500
REQUEST_PAYLOAD_LIMIT_MB=80
